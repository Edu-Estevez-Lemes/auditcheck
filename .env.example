# ÃUDITCHECK - Configuración de entorno
# Copia este archivo como .env y ajusta los valores

# Seguridad - CAMBIAR EN PRODUCCIÓN
SECRET_KEY=cambia-esto-por-una-clave-segura-en-produccion
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Base de datos
DATABASE_URL=sqlite:///./data/auditcheck.db

# Servidor
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Escáner
SCAN_TIMEOUT=2.0
SCAN_MAX_WORKERS=100
